<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StudentMobileApp.Models"
             x:Class="StudentMobileApp.MainPage"
             Title="BUseng SIS"
             BackgroundColor="{AppThemeBinding Light=#F6F8FA, Dark=#0D1117}">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="ThemeToolbarItem"
                     Text="☀"
                     SemanticProperties.Hint="Switch between light and dark themes"
                     Clicked="OnToggleTheme" />
        <ToolbarItem Text="Add" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16,12"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Students"
                   FontSize="25"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#1F2328, Dark=#E6EDF3}" />
            <Label Text="Browse and manage student records"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />

            <Border Margin="0,12,0,2"
                    Padding="4,0"
                    Stroke="{AppThemeBinding Light=#D0D7DE, Dark=#30363D}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161B22}">
                <SearchBar x:Name="Search"
                           HeightRequest="48"
                           Placeholder="Search name or Student ID"
                           TextColor="{AppThemeBinding Light=#1F2328, Dark=#E6EDF3}"
                           PlaceholderColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}"
                           BackgroundColor="Transparent"
                           CancelButtonColor="#1F6FEB"
                           TextChanged="OnSearchChanged" />
            </Border>

            <Label x:Name="ResultsLabel"
                   Margin="2,2,0,0"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="YearFilters" Spacing="8" Padding="0,2">
                <Button Text="All" BackgroundColor="#1F6FEB" TextColor="White"
                        CornerRadius="18" Padding="16,8" FontSize="13" HeightRequest="38"
                        Clicked="OnFilterClicked" CommandParameter="All" />
                <Button Text="1st Year" BackgroundColor="#FFFFFF" TextColor="#1F6FEB"
                        BorderColor="#D0D7DE" BorderWidth="1"
                        CornerRadius="18" Padding="16,8" FontSize="13" HeightRequest="38"
                        Clicked="OnFilterClicked" CommandParameter="1st Year" />
                <Button Text="2nd Year" BackgroundColor="#FFFFFF" TextColor="#1F6FEB"
                        BorderColor="#D0D7DE" BorderWidth="1"
                        CornerRadius="18" Padding="16,8" FontSize="13" HeightRequest="38"
                        Clicked="OnFilterClicked" CommandParameter="2nd Year" />
                <Button Text="3rd Year" BackgroundColor="#FFFFFF" TextColor="#1F6FEB"
                        BorderColor="#D0D7DE" BorderWidth="1"
                        CornerRadius="18" Padding="16,8" FontSize="13" HeightRequest="38"
                        Clicked="OnFilterClicked" CommandParameter="3rd Year" />
                <Button Text="4th Year" BackgroundColor="#FFFFFF" TextColor="#1F6FEB"
                        BorderColor="#D0D7DE" BorderWidth="1"
                        CornerRadius="18" Padding="16,8" FontSize="13" HeightRequest="38"
                        Clicked="OnFilterClicked" CommandParameter="4th Year" />
            </HorizontalStackLayout>
        </ScrollView>

        <RefreshView x:Name="Refresher"
                     Grid.Row="2"
                     RefreshColor="#1F6FEB"
                     Refreshing="OnPullRefresh">
            <CollectionView x:Name="StudentsView"
                            SelectionMode="Single"
                            SelectionChanged="OnStudentSelected"
                            ItemsLayout="VerticalList">
                <CollectionView.EmptyView>
                    <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <ActivityIndicator x:Name="EmptySpinner"
                                               IsRunning="False"
                                               IsVisible="False"
                                               Color="#1F6FEB"
                                               HorizontalOptions="Center" />
                            <Label x:Name="EmptyMessage"
                                   Text="No students found"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#1F2328, Dark=#E6EDF3}" />
                            <Label x:Name="EmptyHint"
                                   Text="Pull down to refresh the list."
                                   FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />
                        </VerticalStackLayout>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Student">
                        <Border Margin="0,0,0,12"
                                Padding="16"
                                Stroke="{AppThemeBinding Light=#E3E8EF, Dark=#30363D}"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161B22}">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="7">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light=#1F2328, Dark=#E6EDF3}" />

                                <Border Grid.Row="0" Grid.Column="1"
                                        Padding="10,5"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{AppThemeBinding Light=#EAF2FF, Dark=#102A4C}"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding YearLevel}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1F6FEB, Dark=#79C0FF}" />
                                </Border>

                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding StudentId, StringFormat='ID  {0}'}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#656D76, Dark=#8B949E}" />

                                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="7">
                                    <BoxView Color="#1F6FEB"
                                             WidthRequest="3"
                                             CornerRadius="2"
                                             VerticalOptions="Fill" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Program}"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light=#1F2328, Dark=#E6EDF3}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
